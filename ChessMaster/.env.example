# ============================================================
# ZOHO CREATOR API CONFIGURATION
# ============================================================
# CRITICAL: All Zoho API variables below are REQUIRED.
# Do NOT use fallbacks or hardcoded values — only environment variables.
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# OAuth2 Credentials (from Zoho Creator Developer Console)
# Register your application and get these values from:
# https://accounts.zoho.in/developerconsole
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REDIRECT_URI=http://127.0.0.1:8000

# Zoho Account Details
# Your Zoho account name (subdomain before .zoho.in)
ZOHO_OWNER_NAME=your_zoho_owner_name
# Your Zoho Creator Application name (exact Link Name)
ZOHO_APP_NAME=your_zoho_app_name

# Zoho Creator Form Names (exact Link Names as they appear in Zoho Creator)
# These are case-sensitive and must match EXACTLY
ZOHO_USER_FORM_NAME=User_Profile
ZOHO_USER_REPORT_NAME=User_Profile_Report
ZOHO_GAME_FORM_NAME=match_history
ZOHO_GAME_REPORT_NAME=match_history_Report

# ============================================================
# SECURE STORAGE CONFIGURATION (Optional)
# ============================================================
# Only override if you have custom secure storage requirements
SECURE_STORAGE_KEY=default-key
SECURE_STORAGE_PATH=./.secure-storage

# ============================================================
# SESSION CONFIGURATION (Optional)
# ============================================================
# Session secret for express-session middleware
# Use a strong random string in production
SESSION_SECRET=chessmaster-secret-key-123

# ============================================================
# NOTES:
# ============================================================
# 1. Form/Report names are LINK NAMES in Zoho Creator (case-sensitive)
# 2. All ZOHO_* variables are validated at server startup
# 3. If any Zoho variable is missing, the server will fail with a clear error
# 4. Do NOT include fallback values — this forces explicit configuration
# 5. For GitHub Codespaces, add these variables to your Codespace secrets
